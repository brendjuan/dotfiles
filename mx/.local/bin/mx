#!/usr/bin/env python3
"""mx: read the battery and set the DPI of a Logitech mouse over HID++ 2.0.

Talks to the mouse directly through its /dev/hidraw node. Works for mice
connected over Bluetooth or a USB cable, not through a Unifying/Bolt receiver.
No extra packages are needed.

    mx battery         show the charge level and charging state
    mx dpi             show the current DPI and the allowed values
    mx dpi 1600        set the DPI
    mx info            device, protocol version, battery and DPI
    mx devices         list the Logitech HID devices found
    mx setup           install a udev rule so sudo is not needed (asks for sudo once)

Protocol: every message is a 20 byte "long" HID report:
    [0x11, device index, feature index, function << 4 | software id, params...]
The device answers with the same first four bytes followed by the result.
Features used: 0x0000 root (look up other features), 0x1004 unified battery,
0x1000 battery level status (older devices), 0x2201 adjustable DPI.
"""

import argparse
import glob
import os
import select
import subprocess
import sys
import time

VENDOR_LOGITECH = 0x046D
REPORT_LONG = 0x11         # 20 byte report; Bluetooth devices only accept this one
REPORT_LEN = 20
DEVICE_INDEX = 0xFF        # "this device", used when not going through a receiver
SW_ID = 0x0A               # marks our requests; replies carry it back (1..15)
REPLY_TIMEOUT_S = 3.0

FEATURE_ROOT = 0x0000
FEATURE_BATTERY_UNIFIED = 0x1004
FEATURE_BATTERY_STATUS = 0x1000
FEATURE_ADJUSTABLE_DPI = 0x2201

HIDPP_ERRORS = {
    1: "unknown", 2: "invalid argument", 3: "out of range", 4: "hardware error",
    5: "internal error", 6: "invalid feature index", 7: "invalid function",
    8: "busy", 9: "unsupported",
}

UDEV_RULE_PATH = "/etc/udev/rules.d/70-mx-hidraw.rules"
UDEV_RULE = """\
# Installed by `mx setup` (dotfiles). Let the logged-in user open the raw HID
# node of Logitech HID++ devices, so `mx` can read the battery and set the DPI.
# 0005 = Bluetooth, 0003 = USB. The file name must sort before
# 73-seat-late.rules, otherwise the uaccess tag has no effect.
SUBSYSTEM=="hidraw", KERNELS=="0005:046D:*", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNELS=="0003:046D:*", TAG+="uaccess"
"""


class MxError(Exception):
    """Any error we want to show to the user as one line."""


# --------------------------------------------------------------------------- #
# device discovery
# --------------------------------------------------------------------------- #

def find_devices():
    """Return [(devnode, name)] for every Logitech HID device with a hidraw node."""
    found = []
    for uevent in sorted(glob.glob("/sys/class/hidraw/hidraw*/device/uevent")):
        info = {}
        with open(uevent) as f:
            for line in f:
                key, _, value = line.strip().partition("=")
                info[key] = value
        # HID_ID looks like 0005:0000046D:0000B034 (bus:vendor:product)
        parts = info.get("HID_ID", "").split(":")
        if len(parts) != 3 or int(parts[1], 16) != VENDOR_LOGITECH:
            continue
        devnode = "/dev/" + uevent.split("/")[4]
        found.append((devnode, info.get("HID_NAME", "?")))
    return found


def pick_device(requested):
    if requested:
        return requested
    devices = find_devices()
    if not devices:
        raise MxError("no Logitech HID device found (is the mouse connected?)")
    if len(devices) > 1:
        names = ", ".join(f"{node} ({name})" for node, name in devices)
        raise MxError(f"several Logitech devices found, pick one with --device: {names}")
    return devices[0][0]


def open_device(path):
    try:
        return os.open(path, os.O_RDWR)
    except PermissionError:
        raise MxError(
            f"cannot open {path}: permission denied. Run `mx setup` once "
            f"(installs a udev rule, asks for sudo), or run this command with sudo."
        )
    except FileNotFoundError:
        raise MxError(f"{path} does not exist")


# --------------------------------------------------------------------------- #
# HID++ transport
# --------------------------------------------------------------------------- #

def request(fd, feature_index, function, params=b""):
    """Send one HID++ 2.0 request and return the reply parameters (16 bytes)."""
    header = bytes([REPORT_LONG, DEVICE_INDEX, feature_index, (function << 4) | SW_ID])
    message = (header + params).ljust(REPORT_LEN, b"\0")
    if len(message) != REPORT_LEN:
        raise MxError("request too long")

    # drop replies or notifications that are still queued from before
    while select.select([fd], [], [], 0)[0]:
        os.read(fd, 64)

    os.write(fd, message)
    deadline = time.monotonic() + REPLY_TIMEOUT_S
    while True:
        left = deadline - time.monotonic()
        if left <= 0:
            raise MxError("no reply from the mouse. If it is asleep, move it and try again.")
        if not select.select([fd], [], [], left)[0]:
            continue
        data = os.read(fd, 64)
        if len(data) < 6 or data[0] not in (0x10, 0x11) or data[1] != DEVICE_INDEX:
            continue
        # HID++ 2.0 error reply: [.., 0xFF, feature index, function|swid, error code]
        if data[2] == 0xFF and data[3] == feature_index and data[4] == header[3]:
            code = data[5]
            raise MxError(f"the mouse rejected the request: {HIDPP_ERRORS.get(code, code)}")
        # HID++ 1.0 error reply (receivers and very old devices)
        if data[2] == 0x8F:
            raise MxError("this device does not speak HID++ 2.0")
        if data[2] == feature_index and data[3] == header[3]:
            return data[4:].ljust(16, b"\0")


def feature_index(fd, feature_id):
    """Ask the root feature where feature_id lives. 0 means not supported."""
    reply = request(fd, FEATURE_ROOT, 0, feature_id.to_bytes(2, "big"))
    return reply[0]


def protocol_version(fd):
    reply = request(fd, FEATURE_ROOT, 1, bytes([0, 0, 0x42]))
    return f"{reply[0]}.{reply[1]}"


# --------------------------------------------------------------------------- #
# battery
# --------------------------------------------------------------------------- #

def read_battery(fd):
    """Return (percent or None, state text)."""
    index = feature_index(fd, FEATURE_BATTERY_UNIFIED)
    if index:
        reply = request(fd, index, 1)               # getStatus
        percent, level_flags, charging = reply[0], reply[1], reply[2]
        states = {0: "discharging", 1: "charging", 2: "charging slowly",
                  3: "full", 4: "charging error"}
        state = states.get(charging, f"state {charging}")
        if percent == 0 and level_flags:
            # device reports only a coarse level, not a percentage
            levels = {1: "critical", 2: "low", 4: "good", 8: "full"}
            return None, f"{levels.get(level_flags, 'unknown level')}, {state}"
        return percent, state

    index = feature_index(fd, FEATURE_BATTERY_STATUS)
    if index:
        reply = request(fd, index, 0)               # getBatteryLevelStatus
        states = {0: "discharging", 1: "charging", 2: "almost full", 3: "full",
                  4: "charging slowly", 5: "invalid battery", 6: "thermal error",
                  7: "charging error"}
        return reply[0], states.get(reply[2], f"state {reply[2]}")

    raise MxError("this device has no battery feature")


def format_battery(percent, state):
    return f"{percent}%  {state}" if percent is not None else state


# --------------------------------------------------------------------------- #
# DPI
# --------------------------------------------------------------------------- #

def parse_dpi_list(values):
    """Decode getSensorDpiList values into (ranges, singles).

    values is a list of 16 bit numbers, ended by the first 0. A value of
    0xE000 + n is a step marker between its two neighbours: 200, 0xE032, 8000
    means every DPI from 200 to 8000 in steps of 50. Other values are single
    allowed DPIs. ranges is [(low, high, step)], singles is [dpi].
    """
    ranges, singles = [], []
    i = 0
    while i < len(values) and values[i]:
        value = values[i]
        if value >= 0xE000 and 0 < i < len(values) - 1 and values[i + 1]:
            low, high = values[i - 1], values[i + 1]
            if singles and singles[-1] == low:
                singles.pop()
            ranges.append((low, high, value - 0xE000))
            i += 2
            continue
        if value < 0xE000:
            singles.append(value)
        i += 1
    return ranges, singles


def dpi_allowed(dpi, ranges, singles):
    if not ranges and not singles:
        return True  # list not understood; let the mouse decide
    if dpi in singles:
        return True
    return any(low <= dpi <= high and (dpi - low) % step == 0
               for low, high, step in ranges)


def format_dpi_list(ranges, singles):
    parts = [f"{low}-{high} in steps of {step}" for low, high, step in ranges]
    parts += [str(v) for v in singles]
    return ", ".join(parts) or "unknown"


def dpi_feature(fd):
    index = feature_index(fd, FEATURE_ADJUSTABLE_DPI)
    if not index:
        raise MxError("this device has no adjustable DPI feature (0x2201)")
    return index


def read_dpi(fd, index, sensor=0):
    """Return (current dpi, default dpi)."""
    reply = request(fd, index, 2, bytes([sensor]))  # getSensorDpi
    return int.from_bytes(reply[1:3], "big"), int.from_bytes(reply[3:5], "big")


def read_dpi_list(fd, index, sensor=0):
    reply = request(fd, index, 1, bytes([sensor]))  # getSensorDpiList
    values = [int.from_bytes(reply[i:i + 2], "big") for i in range(1, 15, 2)]
    return parse_dpi_list(values)


def write_dpi(fd, index, dpi, sensor=0):
    request(fd, index, 3, bytes([sensor]) + dpi.to_bytes(2, "big"))  # setSensorDpi


# --------------------------------------------------------------------------- #
# commands
# --------------------------------------------------------------------------- #

def cmd_devices(args):
    devices = find_devices()
    if not devices:
        print("no Logitech HID device found")
    for node, name in devices:
        print(f"{node}  {name}")


def cmd_battery(args):
    fd = open_device(pick_device(args.device))
    print(format_battery(*read_battery(fd)))


def cmd_dpi(args):
    fd = open_device(pick_device(args.device))
    index = dpi_feature(fd)
    ranges, singles = read_dpi_list(fd, index)
    if args.value is None:
        current, default = read_dpi(fd, index)
        print(f"{current} dpi  (default {default}; allowed: {format_dpi_list(ranges, singles)})")
        return
    if not dpi_allowed(args.value, ranges, singles):
        raise MxError(f"{args.value} is not allowed; allowed: {format_dpi_list(ranges, singles)}")
    write_dpi(fd, index, args.value)
    current, _ = read_dpi(fd, index)
    if current != args.value:
        raise MxError(f"asked for {args.value} dpi but the mouse reports {current}")
    print(f"dpi set to {current}")


def cmd_info(args):
    path = pick_device(args.device)
    name = dict(find_devices()).get(path, "?")
    fd = open_device(path)
    print(f"{name}  ({path}, HID++ {protocol_version(fd)})")
    print(f"battery: {format_battery(*read_battery(fd))}")
    try:
        index = dpi_feature(fd)
        current, default = read_dpi(fd, index)
        print(f"dpi:     {current} (default {default}; allowed: "
              f"{format_dpi_list(*read_dpi_list(fd, index))})")
    except MxError as e:
        print(f"dpi:     {e}")


def cmd_setup(args):
    print(f"writing {UDEV_RULE_PATH} (sudo)")
    subprocess.run(["sudo", "tee", UDEV_RULE_PATH], input=UDEV_RULE.encode(),
                   stdout=subprocess.DEVNULL, check=True)
    subprocess.run(["sudo", "udevadm", "control", "--reload-rules"], check=True)
    subprocess.run(["sudo", "udevadm", "trigger", "--subsystem-match=hidraw",
                    "--action=add"], check=True)
    print("done. If `mx battery` still reports permission denied, switch the mouse off and on.")


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="mx",
        description="Battery and DPI of a Logitech mouse over HID++.",
        epilog="Run `mx setup` once so the commands work without sudo.",
    )
    parser.add_argument("--device", metavar="/dev/hidrawN",
                        help="hidraw node to use (default: the only Logitech device found)")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("battery", help="show the charge level").set_defaults(func=cmd_battery)
    p = sub.add_parser("dpi", help="show or set the DPI")
    p.add_argument("value", nargs="?", type=int, help="new DPI; omit to show the current one")
    p.set_defaults(func=cmd_dpi)
    sub.add_parser("info", help="device, battery and DPI").set_defaults(func=cmd_info)
    sub.add_parser("devices", help="list Logitech HID devices").set_defaults(func=cmd_devices)
    sub.add_parser("setup", help="install the udev rule (needs sudo)").set_defaults(func=cmd_setup)

    args = parser.parse_args(argv)
    try:
        args.func(args)
    except MxError as e:
        print(f"mx: {e}", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as e:
        print(f"mx: command failed: {' '.join(e.cmd)}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
