{
    "layer": "top",
    "position": "top",
    "height": 16,
    "modules-left": ["dwl/tags"],
    "modules-center": ["wlr/taskbar"],
    "modules-right": ["tray", "custom/mouse", "custom/zenoh", "custom/highcontrast", "custom/recording", "custom/rivercast", "custom/github", "custom/ccm-battery", "custom/claude-usage", "dwl/window", "backlight", "cpu", "memory", "pulseaudio", "battery", "clock"],

    "tray": {
        "icon-size": 14,
        "spacing": 6
    },

    "custom/zenoh": {
        "exec": "~/.config/cwc/scripts/zenoh-operator.sh status",
        "return-type": "json",
        "interval": 3,
        "signal": 8,
        "on-click": "~/.config/cwc/scripts/zenoh-operator.sh",
        "on-click-right": "~/.config/cwc/scripts/zenoh-operator.sh logwin"
    },

    "custom/mouse": {
        "exec": "~/.config/cwc/scripts/mx-mouse.sh status",
        "return-type": "json",
        "interval": 10,
        "signal": 9,
        "on-click": "~/.config/cwc/scripts/mx-mouse.sh pick",
        "on-click-right": "~/.config/cwc/scripts/mx-mouse.sh details"
    },

    "custom/highcontrast": {
        "exec": "[ -f ~/.cache/high-contrast-mode ] && echo '󰌁' || echo '󱡓'",
        "interval": 2,
        "on-click": "~/.config/cwc/scripts/high-contrast.sh",
        "tooltip": false
    },

    "custom/recording": {
        "exec": "if pgrep -x wf-recorder > /dev/null; then echo '󰑋 REC'; else echo ''; fi",
        "interval": 2,
        "on-click": "pkill -INT wf-recorder || true",
        "tooltip": false
    },

    "custom/rivercast": {
        "exec": "~/.config/cwc/scripts/rivercast.py",
        "return-type": "json",
        "interval": 300,
        "on-click": "xdg-open https://www.phillyrivercast.org/"
    },

    "custom/github": {
        "exec": "~/.config/cwc/scripts/github-status.py",
        "return-type": "json",
        "interval": 120,
        "on-click": "xdg-open https://www.githubstatus.com/"
    },

    "custom/package": {
        "exec": "~/.config/cwc/scripts/package-tracker.py",
        "return-type": "json",
        "interval": 600,
        "on-click": "~/.config/cwc/scripts/package-tracker.py --open"
    },

    "custom/ccm-battery": {
        "exec": "~/.config/cwc/scripts/ccm-battery.py",
        "return-type": "json",
        "restart-interval": 30,
        "on-click": "kitty --app-id float-term --title 'CCM BATTERY' -o initial_window_width=92c -o initial_window_height=28c ~/.config/cwc/scripts/ccm-battery.py --echo"
    },

    "custom/claude-usage": {
        "exec": "~/.config/cwc/scripts/claude-usage.py",
        "return-type": "json",
        "interval": 45,
        "on-click": "kitty --app-id float-term --title 'CLAUDE USAGE' -o initial_window_width=92c -o initial_window_height=36c ~/.config/cwc/scripts/claude-dashboard.py"
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 12,
        "on-click": "activate",
        "on-click-middle": "close",
        "tooltip-format": "{title}",
        "all-outputs": false
    },

    "dwl/tags": {
        "num-tags": 12,
        "tag-labels": ["ア", "イ", "ウ", "エ", "オ", "カ", "キ", "ク", "ケ", "GZ", "RV", "FG"]
    },

    "dwl/window": {
        "format": "{layout}",
        "tooltip": false
    },

    "backlight": {
        "format": "󰃠 {percent}%",
        "tooltip": false
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 5,
        "on-click": "kitty --app-id float-term btop"
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 5,
        "on-click": "kitty --app-id float-term btop"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "interval": 30,
        "states": {
            "warning": 20,
            "critical": 10
        }
    },

    "clock": {
        "format": "{:%a %b %d  %H:%M}"
    }
}
