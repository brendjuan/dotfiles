#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["textual>=8,<9"]
# ///
import argparse
import difflib
import hashlib
import json
import os
import re
import subprocess
import sys
import time
from dataclasses import dataclass, field
from itertools import accumulate

from rich.cells import cell_len
from rich.style import Style
from rich.syntax import Syntax
from rich.text import Text
from textual import work
from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.containers import Container, ScrollableContainer
from textual.widgets import Footer, Static, Tree
from textual.widgets.tree import TreeNode

CONTEXT_STEPS = (3, 10, 25)
EXPAND_STEP = 20
MIN_FOLD = 3
POLL_SECONDS = 2.0
PANE_FRACTION = 0.45
MAX_RENDER_LINES = 20000
MAX_LINE_WIDTH = 500
LAYOUTS = ("side", "top", "hidden")
FETCH_SECONDS = 60.0
PR_URL_RE = re.compile(r"github\.com/[^/\s]+/[^/\s]+/pull/(\d+)")

PALETTES = {
    "dark": {
        "add": "#10331c",
        "del": "#3d1a1d",
        "add_emph": "#1d6b34",
        "del_emph": "#8a2f34",
        "syntax": "ansi_dark",
        "theme": "ansi-dark",
    },
    "light": {
        "add": "#e6ffec",
        "del": "#ffebe9",
        "add_emph": "#abf2bc",
        "del_emph": "#ffc0c0",
        "syntax": "ansi_light",
        "theme": "ansi-light",
    },
}
STATUS_STYLE = {"A": "green", "?": "green", "D": "red", "R": "yellow", "C": "yellow", "T": "magenta"}

HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")
TOKEN_RE = re.compile(r"\w+|\s+|[^\w\s]")


class GitError(Exception):
    pass


def run_git(root, *args, binary=False):
    proc = subprocess.run(["git", "-C", root, "--no-optional-locks", *args], capture_output=True)
    if proc.returncode != 0:
        message = proc.stderr.decode(errors="replace").strip()
        raise GitError(message or f"git {' '.join(args)} failed")
    return proc.stdout if binary else proc.stdout.decode(errors="replace")


def repo_root(path):
    try:
        return run_git(path, "rev-parse", "--show-toplevel").strip()
    except GitError:
        raise GitError(f"{path} is not inside a git repository")


def find_worktree(root, name):
    worktrees = []
    path = branch = None
    for line in run_git(root, "worktree", "list", "--porcelain").splitlines() + [""]:
        if line.startswith("worktree "):
            path = line[len("worktree ") :]
        elif line.startswith("branch "):
            branch = line[len("branch ") :].removeprefix("refs/heads/")
        elif not line and path:
            worktrees.append((path, branch))
            path = branch = None
    target = os.path.abspath(name) if os.path.exists(name) else None
    for path, branch in worktrees:
        if path in (name, target) or name in (os.path.basename(path), branch):
            return path
    known = ", ".join(os.path.basename(path) for path, _ in worktrees)
    raise GitError(f"no worktree named {name}; known worktrees: {known}")


def rev_parse(root, ref):
    try:
        return run_git(root, "rev-parse", "--verify", "-q", f"{ref}^{{commit}}").strip()
    except GitError:
        raise GitError(f"unknown revision: {ref}")


def default_branch(root):
    try:
        return run_git(root, "symbolic-ref", "-q", "--short", "refs/remotes/origin/HEAD").strip()
    except GitError:
        pass
    for name in ("origin/main", "origin/master", "main", "master"):
        try:
            rev_parse(root, name)
            return name
        except GitError:
            continue
    return None


@dataclass
class Compare:
    base: str
    head: str | None
    base_label: str
    head_label: str

    def range_args(self):
        return [self.base] + ([self.head] if self.head else [])


def compare_refs(root, a, b, merge_base):
    rev_parse(root, a)
    rev_parse(root, b)
    return Compare(run_git(root, "merge-base", a, b).strip() if merge_base else a, b, a, b)


def resolve_compare(root, refs):
    if len(refs) > 2:
        raise GitError("give at most two revisions")
    if len(refs) == 2:
        return compare_refs(root, *refs, merge_base=True)
    if len(refs) == 1 and ".." in refs[0]:
        a, _, b = refs[0].partition("..")
        return compare_refs(root, a, b.lstrip("."), merge_base=b.startswith("."))
    if refs:
        rev_parse(root, refs[0])
        return Compare(refs[0], None, refs[0], "working tree")
    branch = default_branch(root)
    if branch:
        base = run_git(root, "merge-base", branch, "HEAD").strip()
        if base != rev_parse(root, "HEAD"):
            return Compare(base, None, f"{branch} (merge base)", "working tree")
    return Compare("HEAD", None, "HEAD", "working tree")


def resolve_pr(root, pr, local=False):
    match = PR_URL_RE.search(pr)
    number = match.group(1) if match else pr.lstrip("#")
    proc = subprocess.run(
        ["gh", "pr", "view", *([] if number == "current" else [number]), "--json", "number,baseRefName,headRefName"],
        cwd=root,
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        raise GitError(proc.stderr.strip() or "gh pr view failed")
    info = json.loads(proc.stdout)
    base_branch, head_branch = info["baseRefName"], info["headRefName"]
    label = f"PR #{info['number']} {head_branch}"
    refspecs = [f"+refs/heads/{base_branch}:refs/remotes/origin/{base_branch}"]
    if local:
        try:
            rev_parse(root, head_branch)
        except GitError:
            raise GitError(f"branch {head_branch} does not exist locally; drop --local to use the pushed head")
        if run_git(root, "branch", "--show-current").strip() == head_branch:
            head, head_ref, label = None, "HEAD", f"{label} (working tree)"
        else:
            head = head_ref = head_branch
            label += " (local)"
    else:
        head = head_ref = f"refs/remotes/origin/pr/{info['number']}"
        refspecs.insert(0, f"+refs/pull/{info['number']}/head:{head}")
    run_git(root, "fetch", "-q", "origin", *refspecs)
    base = run_git(root, "merge-base", f"origin/{base_branch}", head_ref).strip()
    return Compare(base, head, f"origin/{base_branch}", label)


def resolve_target(root, refs, pr, local=False):
    return resolve_pr(root, pr, local) if pr else resolve_compare(root, refs)


@dataclass
class FileEntry:
    path: str
    old_path: str
    status: str
    added: int | None = None
    removed: int | None = None
    binary: bool = False
    untracked: bool = False


def worktree_bytes(root, path):
    try:
        with open(os.path.join(root, path), "rb") as handle:
            return handle.read()
    except OSError:
        return None


def show_bytes(root, rev, path):
    try:
        return run_git(root, "show", f"{rev}:{path}", binary=True)
    except GitError:
        return None


def list_files(root, cmp):
    entries = {}
    status_out = run_git(root, "diff", "--name-status", "-M", "-z", *cmp.range_args()).split("\0")
    i = 0
    while i < len(status_out) and status_out[i]:
        code = status_out[i][0]
        if code in "RC":
            old, new = status_out[i + 1], status_out[i + 2]
            i += 3
        else:
            old = new = status_out[i + 1]
            i += 2
        entries[new] = FileEntry(new, old, code)
    num_out = run_git(root, "diff", "--numstat", "-M", "-z", *cmp.range_args()).split("\0")
    i = 0
    while i < len(num_out) and num_out[i]:
        added, removed, path = num_out[i].split("\t", 2)
        if path == "":
            path = num_out[i + 2]
            i += 3
        else:
            i += 1
        entry = entries.get(path)
        if entry is None:
            continue
        if added == "-":
            entry.binary = True
        else:
            entry.added = int(added)
            entry.removed = int(removed)
    if cmp.head is None:
        for path in run_git(root, "ls-files", "--others", "--exclude-standard", "-z").split("\0"):
            if not path or path in entries:
                continue
            data = worktree_bytes(root, path)
            if data is None:
                continue
            entry = FileEntry(path, path, "?", untracked=True)
            if b"\0" in data[:8000]:
                entry.binary = True
            else:
                entry.added, entry.removed = len(data.splitlines()), 0
            entries[path] = entry
    return [entries[p] for p in sorted(entries)]


def fingerprint(root, cmp, current):
    parts = [run_git(root, "diff", "--numstat", "-M", "-z", *cmp.range_args())]
    parts.append(run_git(root, "rev-parse", "HEAD", *cmp.range_args()))
    if cmp.head is None:
        parts.append(run_git(root, "ls-files", "--others", "--exclude-standard", "-z"))
        if current:
            data = worktree_bytes(root, current)
            parts.append(hashlib.sha1(data).hexdigest() if data is not None else "missing")
    return hashlib.sha1("\0".join(parts).encode()).hexdigest()


def split_lines(text):
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    return lines


def highlight(path, text, count, syntax_theme):
    if count == 0:
        return []
    lexer = Syntax.guess_lexer(path, code=text)
    try:
        rich = Syntax(text, lexer, theme=syntax_theme, word_wrap=False).highlight(text)
    except Exception:
        rich = Text(text)
    lines = list(rich.split("\n"))[:count]
    lines.extend(Text("") for _ in range(count - len(lines)))
    return lines


def parse_blocks(root, cmp, entry):
    args = ["diff", "-U0", "-M", *cmp.range_args(), "--", entry.old_path]
    if entry.path != entry.old_path:
        args.append(entry.path)
    blocks = []
    for line in run_git(root, *args).splitlines():
        match = HUNK_RE.match(line)
        if not match:
            continue
        old_start, old_len, new_start, new_len = (1 if g is None else int(g) for g in match.groups())
        blocks.append((old_start - 1 if old_len else old_start, old_len, new_start - 1 if new_len else new_start, new_len))
    return blocks


@dataclass
class FileView:
    entry: FileEntry
    old_lines: list[str] = field(default_factory=list)
    new_lines: list[str] = field(default_factory=list)
    old_rich: list[Text] = field(default_factory=list)
    new_rich: list[Text] = field(default_factory=list)
    blocks: list[tuple[int, int, int, int]] = field(default_factory=list)
    message: str | None = None

    def gaps(self):
        result = []
        old_pos = new_pos = 0
        for old_start, old_len, new_start, new_len in self.blocks:
            result.append((old_pos, new_pos, max(0, min(old_start - old_pos, new_start - new_pos))))
            old_pos = old_start + old_len
            new_pos = new_start + new_len
        result.append((old_pos, new_pos, max(0, min(len(self.old_lines) - old_pos, len(self.new_lines) - new_pos))))
        return result


def decode_text(data):
    return data.decode("utf-8", errors="replace").expandtabs(4) if data is not None else ""


def build_view(root, cmp, entry, syntax_theme):
    view = FileView(entry)
    if entry.binary:
        view.message = "Binary file"
        return view
    old_text = "" if entry.status in "A?" else decode_text(show_bytes(root, cmp.base, entry.old_path))
    if entry.status == "D":
        new_text = ""
    elif cmp.head is None:
        new_text = decode_text(worktree_bytes(root, entry.path))
    else:
        new_text = decode_text(show_bytes(root, cmp.head, entry.path))
    view.old_lines = split_lines(old_text)
    view.new_lines = split_lines(new_text)
    if entry.untracked:
        view.blocks = [(0, 0, 0, len(view.new_lines))]
    else:
        view.blocks = parse_blocks(root, cmp, entry)
    view.old_rich = highlight(entry.old_path, old_text, len(view.old_lines), syntax_theme)
    view.new_rich = highlight(entry.path, new_text, len(view.new_lines), syntax_theme)
    if not view.blocks:
        view.message = "No text changes"
    return view


def emphasize(old_line, new_line, palette):
    old_tokens = TOKEN_RE.findall(old_line.plain)
    new_tokens = TOKEN_RE.findall(new_line.plain)
    matcher = difflib.SequenceMatcher(None, old_tokens, new_tokens, autojunk=False)
    if matcher.ratio() < 0.5:
        return
    old_offsets = [0, *accumulate(map(len, old_tokens))]
    new_offsets = [0, *accumulate(map(len, new_tokens))]
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag == "equal":
            continue
        if i2 > i1:
            old_line.stylize(Style(bgcolor=palette["del_emph"]), old_offsets[i1], old_offsets[i2])
        if j2 > j1:
            new_line.stylize(Style(bgcolor=palette["add_emph"]), new_offsets[j1], new_offsets[j2])


class Renderer:
    def __init__(self, view, context, expansions, whole, min_width, palette):
        self.view = view
        self.context = context
        self.expansions = expansions
        self.whole = whole
        self.palette = palette
        self.numw = max(3, len(str(max(len(view.old_lines), len(view.new_lines), 1))))
        self.prefix = self.numw * 2 + 4
        longest = max((cell_len(line) for line in view.old_lines + view.new_lines), default=0)
        self.width = min(max(20, min_width, longest + self.prefix), MAX_LINE_WIDTH)

    def line(self, old_no, new_no, marker, source, kind):
        text = Text(no_wrap=True, overflow="crop")
        text.append(f"{old_no:>{self.numw}} " if old_no else " " * (self.numw + 1), style="dim")
        text.append(f"{new_no:>{self.numw}} " if new_no else " " * (self.numw + 1), style="dim")
        text.append(f"{marker} ", style={"add": "bold green", "del": "bold red"}.get(kind, "dim"))
        text.append_text(source)
        text.pad_right(max(0, self.width - text.cell_len))
        if kind in ("add", "del"):
            text.stylize(Style(bgcolor=self.palette[kind]), self.prefix - 2)
        return text

    def context_lines(self, old_start, new_start, count):
        view = self.view
        return [
            self.line(old_start + k + 1, new_start + k + 1, " ", view.new_rich[new_start + k].copy(), "ctx")
            for k in range(count)
        ]

    def block_lines(self, block):
        view = self.view
        old_start, old_len, new_start, new_len = block
        old_rich = [view.old_rich[old_start + k].copy() for k in range(old_len)]
        new_rich = [view.new_rich[new_start + k].copy() for k in range(new_len)]
        if old_len == new_len:
            for old_line, new_line in zip(old_rich, new_rich):
                emphasize(old_line, new_line, self.palette)
        lines = [self.line(old_start + k + 1, None, "-", old_rich[k], "del") for k in range(old_len)]
        lines += [self.line(None, new_start + k + 1, "+", new_rich[k], "add") for k in range(new_len)]
        return lines

    def expander(self, index, hidden, up, down):
        parts = [f"[dim]  ⋯ {hidden} hidden lines  [/]"]
        if up:
            parts.append(f"[@click=app.expand({index},'up')][b]↑ {min(EXPAND_STEP, hidden)} more[/b][/]  ")
        parts.append(f"[@click=app.expand({index},'all')][b]↕ show all[/b][/]  ")
        if down:
            parts.append(f"[@click=app.expand({index},'down')][b]↓ {min(EXPAND_STEP, hidden)} more[/b][/]")
        return "".join(parts)

    def widgets(self):
        view = self.view
        if view.message:
            return [Static(Text(view.message, style="dim"))]
        result = []
        pending = []
        budget = MAX_RENDER_LINES

        def flush():
            nonlocal pending
            if pending:
                result.append(Static(Text("\n", no_wrap=True, overflow="crop").join(pending), classes="code"))
                pending = []

        def emit(lines):
            nonlocal budget
            budget -= len(lines)
            pending.extend(lines[: max(0, len(lines) + budget)] if budget < 0 else lines)

        gaps = view.gaps()
        last_index = len(view.blocks)
        for index, (old_start, new_start, length) in enumerate(gaps):
            first = index == 0
            last = index == last_index
            state = self.expansions.get(index, [0, 0])
            top = 0 if first else self.context + (0 if state == "all" else state[0])
            bottom = 0 if last else self.context + (0 if state == "all" else state[1])
            if self.whole or state == "all" or top + bottom + MIN_FOLD > length:
                emit(self.context_lines(old_start, new_start, length))
            else:
                emit(self.context_lines(old_start, new_start, top))
                flush()
                hidden = length - top - bottom
                result.append(Static(self.expander(index, hidden, not first, not last), classes="gap"))
                tail_old = old_start + length - bottom
                tail_new = new_start + length - bottom
                emit(self.context_lines(tail_old, tail_new, bottom))
            if index < last_index:
                emit(self.block_lines(view.blocks[index]))
            if budget < 0:
                flush()
                result.append(Static(Text(f"  ⋯ stopped after {MAX_RENDER_LINES} lines", style="dim"), classes="gap"))
                return result
        flush()
        return result


def file_label(entry):
    name = entry.path.rsplit("/", 1)[-1]
    text = Text(name, style=STATUS_STYLE.get(entry.status, ""))
    if entry.status in "RC" and entry.old_path != entry.path:
        text.append(f" ← {entry.old_path.rsplit('/', 1)[-1]}", style="dim")
    if entry.binary:
        text.append(" bin", style="dim")
    else:
        if entry.added:
            text.append(f" +{entry.added}", style="green")
        if entry.removed:
            text.append(f" -{entry.removed}", style="red")
    return text


class DiffApp(App):
    CSS = """
    Screen { layout: vertical; }
    #title { height: 1; padding: 0 1; text-style: bold; }
    #body { height: 1fr; }
    #body.side { layout: horizontal; }
    #body.top { layout: vertical; }
    #body.side #files { width: 32%; min-width: 24; max-width: 48; height: 1fr; border-right: solid $secondary; }
    #body.top #files { width: 1fr; height: 30%; min-height: 5; border-bottom: solid $secondary; }
    #diff { width: 1fr; height: 1fr; }
    #diff Static { width: auto; }
    #diff .code { text-wrap: nowrap; text-overflow: clip; }
    #diff .gap { color: $text-muted; }
    #diff .filehead { text-style: bold; padding: 0 1; }
    Tree { padding: 0; }
    """
    BINDINGS = [
        Binding("q", "quit", "Quit"),
        Binding("j,]", "next_file", "Next file"),
        Binding("k,[", "prev_file", "Prev file"),
        Binding("e", "expand_all", "Expand all"),
        Binding("w", "whole_file", "Whole file"),
        Binding("c", "cycle_context", "Context"),
        Binding("t", "toggle_tree", "Tree"),
        Binding("r", "refresh", "Refresh"),
        Binding("h", "scroll_diff(-8)", "Scroll left", show=False),
        Binding("l", "scroll_diff(8)", "Scroll right", show=False),
        Binding("tab", "focus_next", "Switch pane", show=False),
        Binding("shift+tab", "focus_previous", "Switch pane", show=False),
    ]

    def __init__(self, root, refs, compare, context, layout="top", pr=None, pr_local=False):
        super().__init__(ansi_color=True)
        self.layout = layout if layout in LAYOUTS else "top"
        self.mode = terminal_mode()
        self.theme = PALETTES[self.mode]["theme"]
        self.root = root
        self.refs = refs
        self.pr = pr
        self.pr_local = pr_local
        self.last_fetch = time.monotonic()
        self.compare = compare
        self.context = context if context in CONTEXT_STEPS else CONTEXT_STEPS[0]
        self.files = []
        self.leaves = []
        self.current = None
        self.view = None
        self.expansions = {}
        self.whole = set()
        self.last_fingerprint = None
        self.resize_timer = None

    def compose(self) -> ComposeResult:
        yield Static(id="title", markup=False)
        with Container(id="body", classes="top" if self.layout == "top" else "side"):
            yield Tree("files", id="files")
            yield ScrollableContainer(id="diff")
        yield Footer()

    def on_mount(self):
        tree = self.query_one("#files", Tree)
        tree.show_root = False
        tree.guide_depth = 2
        self.apply_layout(self.layout)
        self.set_title(Text("loading…", style="dim"))
        self.load()
        self.set_interval(POLL_SECONDS, self.check_changes)

    def apply_layout(self, layout):
        self.layout = layout
        body = self.query_one("#body", Container)
        tree = self.query_one("#files", Tree)
        body.remove_class("side", "top")
        body.add_class("top" if layout == "top" else "side")
        tree.display = layout != "hidden"
        (tree if tree.display else self.query_one("#diff", ScrollableContainer)).focus()
        self.call_after_refresh(self.render_view, keep_scroll=True)

    def set_title(self, text):
        self.query_one("#title", Static).update(text)

    @work(thread=True, exclusive=True, group="load")
    def load(self):
        try:
            compare = resolve_target(self.root, self.refs, self.pr, self.pr_local)
            self.last_fetch = time.monotonic()
            files = list_files(self.root, compare)
            stamp = fingerprint(self.root, compare, self.current)
        except GitError as error:
            self.call_from_thread(self.show_error, str(error))
            return
        self.call_from_thread(self.apply_files, compare, files, stamp)

    def show_error(self, message):
        self.set_title(Text(message, style="bold red"))
        self.notify(message, severity="error")

    def apply_files(self, compare, files, stamp):
        self.compare = compare
        self.files = files
        self.last_fingerprint = stamp
        self.title = f"diff {compare.base_label} → {compare.head_label}"
        added = sum(f.added or 0 for f in files)
        removed = sum(f.removed or 0 for f in files)
        title = Text()
        title.append(compare.base_label)
        title.append(" → ", style="dim")
        title.append(compare.head_label)
        title.append(f"   {len(files)} file{'s' if len(files) != 1 else ''}", style="dim")
        title.append(f"  +{added}", style="green")
        title.append(f" -{removed}", style="red")
        self.set_title(title)
        self.build_tree(files)
        paths = [f.path for f in files]
        if self.current not in paths:
            self.current = self.leaves[0].data.path if self.leaves else None
            self.expansions = {}
            self.whole.discard(self.current)
        if self.current:
            node = next((n for n in self.leaves if n.data.path == self.current), None)
            tree = self.query_one("#files", Tree)
            if node is not None:
                self.call_after_refresh(tree.move_cursor, node)
                self.call_after_refresh(tree.scroll_to_node, node, animate=False)
            self.open_file(next(f for f in files if f.path == self.current), keep_scroll=True)
        else:
            self.view = None
            diff = self.query_one("#diff", ScrollableContainer)
            diff.remove_children()
            diff.mount(Static(Text("No changes", style="dim"), classes="filehead"))

    def build_tree(self, files):
        tree = self.query_one("#files", Tree)
        tree.clear()
        self.leaves = []
        nested = {}
        for entry in files:
            parts = entry.path.split("/")
            node = nested
            for part in parts[:-1]:
                node = node.setdefault(part, {})
            node[parts[-1]] = entry

        def add(parent: TreeNode, mapping):
            names = sorted(mapping, key=lambda n: (isinstance(mapping[n], FileEntry), n))
            for name in names:
                child = mapping[name]
                if isinstance(child, dict):
                    label = name
                    while len(child) == 1 and isinstance(next(iter(child.values())), dict):
                        key = next(iter(child))
                        label += "/" + key
                        child = child[key]
                    add(parent.add(Text(label, style="bold"), expand=True), child)
                else:
                    self.leaves.append(parent.add_leaf(file_label(child), data=child))

        add(tree.root, nested)
        tree.root.expand_all()

    def on_tree_node_highlighted(self, event: Tree.NodeHighlighted):
        entry = event.node.data
        if isinstance(entry, FileEntry) and entry.path != self.current:
            self.current = entry.path
            self.open_file(entry, keep_scroll=False)

    def on_tree_node_selected(self, event: Tree.NodeSelected):
        if isinstance(event.node.data, FileEntry):
            self.query_one("#diff", ScrollableContainer).focus()

    @work(thread=True, exclusive=True, group="view")
    def open_file(self, entry, keep_scroll):
        try:
            view = build_view(self.root, self.compare, entry, PALETTES[self.mode]["syntax"])
        except GitError as error:
            view = FileView(entry, message=str(error))
        self.call_from_thread(self.show_view, view, keep_scroll)

    def show_view(self, view, keep_scroll):
        if view.entry.path != self.current:
            return
        self.view = view
        self.render_view(keep_scroll)

    def render_view(self, keep_scroll):
        if self.view is None:
            return
        diff = self.query_one("#diff", ScrollableContainer)
        scroll_x = diff.scroll_x if keep_scroll else 0
        scroll_y = diff.scroll_y if keep_scroll else 0
        width = diff.scrollable_content_region.width or diff.size.width or 80
        entry = self.view.entry
        head = Text()
        head.append(entry.path, style=STATUS_STYLE.get(entry.status, "bold"))
        if entry.old_path != entry.path:
            head.append(f"  (was {entry.old_path})", style="dim")
        if entry.added:
            head.append(f"  +{entry.added}", style="green")
        if entry.removed:
            head.append(f" -{entry.removed}", style="red")
        if entry.path in self.whole:
            head.append("  whole file", style="dim")
        renderer = Renderer(
            self.view,
            self.context,
            self.expansions.get(entry.path, {}),
            entry.path in self.whole,
            width,
            PALETTES[self.mode],
        )
        widgets = [Static(head, classes="filehead")] + renderer.widgets()
        diff.remove_children()
        diff.mount(*widgets)
        self.call_after_refresh(diff.scroll_to, x=scroll_x, y=scroll_y, animate=False)

    def action_expand(self, index: int, where: str):
        if self.view is None:
            return
        per_file = self.expansions.setdefault(self.view.entry.path, {})
        if where == "all":
            per_file[index] = "all"
        else:
            state = per_file.get(index)
            if state == "all":
                return
            state = list(state or [0, 0])
            if where == "down":
                state[0] += EXPAND_STEP
            else:
                state[1] += EXPAND_STEP
            per_file[index] = state
        self.render_view(keep_scroll=True)

    def action_expand_all(self):
        if self.view is None:
            return
        per_file = self.expansions.setdefault(self.view.entry.path, {})
        for index in range(len(self.view.blocks) + 1):
            per_file[index] = "all"
        self.render_view(keep_scroll=True)

    def action_whole_file(self):
        if self.view is None:
            return
        self.whole ^= {self.view.entry.path}
        self.render_view(keep_scroll=True)

    def action_cycle_context(self):
        index = (CONTEXT_STEPS.index(self.context) + 1) % len(CONTEXT_STEPS)
        self.context = CONTEXT_STEPS[index]
        self.notify(f"context: {self.context} lines", timeout=1.5)
        self.render_view(keep_scroll=True)

    def action_toggle_tree(self):
        self.apply_layout(LAYOUTS[(LAYOUTS.index(self.layout) + 1) % len(LAYOUTS)])

    def action_scroll_diff(self, delta: int):
        diff = self.query_one("#diff", ScrollableContainer)
        diff.scroll_to(x=max(0, diff.scroll_x + delta), animate=False)

    def action_refresh(self):
        self.load()

    def step_file(self, delta):
        if not self.leaves:
            return
        tree = self.query_one("#files", Tree)
        index = next((i for i, n in enumerate(self.leaves) if n.data.path == self.current), -1)
        node = self.leaves[max(0, min(len(self.leaves) - 1, index + delta))]
        tree.move_cursor(node)
        tree.scroll_to_node(node, animate=False)

    def action_next_file(self):
        self.step_file(1)

    def action_prev_file(self):
        self.step_file(-1)

    def on_resize(self):
        if self.resize_timer is not None:
            self.resize_timer.stop()
        self.resize_timer = self.set_timer(0.15, lambda: self.render_view(keep_scroll=True))

    @work(thread=True, exclusive=True, group="poll")
    def check_changes(self):
        mode = terminal_mode()
        if mode != self.mode:
            self.call_from_thread(self.apply_mode, mode)
        try:
            if self.pr and time.monotonic() - self.last_fetch > FETCH_SECONDS:
                self.last_fetch = time.monotonic()
                resolve_pr(self.root, self.pr, self.pr_local)
            stamp = fingerprint(self.root, self.compare, self.current)
        except GitError:
            return
        if stamp != self.last_fingerprint:
            self.call_from_thread(self.load)

    def apply_mode(self, mode):
        self.mode = mode
        self.theme = PALETTES[mode]["theme"]
        if self.view is not None:
            self.open_file(self.view.entry, keep_scroll=True)


def kitty(*args, check=True):
    listen = os.environ.get("KITTY_LISTEN_ON", "")
    pass_fds = (int(listen[3:]),) if listen.startswith("fd:") and listen[3:].isdigit() else ()
    proc = subprocess.run(["kitty", "@", *args], capture_output=True, text=True, pass_fds=pass_fds)
    if check and proc.returncode != 0:
        raise SystemExit(f"kitty @ {args[0]}: {proc.stderr.strip()}")
    return proc.stdout


def terminal_mode():
    if not os.environ.get("KITTY_LISTEN_ON"):
        return "dark"
    args = ["get-colors"]
    if os.environ.get("KITTY_WINDOW_ID"):
        args += ["--match", f"id:{os.environ['KITTY_WINDOW_ID']}"]
    for line in kitty(*args, check=False).splitlines():
        name, _, value = line.partition(" ")
        value = value.strip()
        if name == "background" and len(value) == 7 and value.startswith("#"):
            red, green, blue = (int(value[i : i + 2], 16) for i in (1, 3, 5))
            return "light" if 0.2126 * red + 0.7152 * green + 0.0722 * blue > 128 else "dark"
    return "dark"


def kitty_windows():
    for os_window in json.loads(kitty("ls")):
        for tab in os_window["tabs"]:
            for window in tab["windows"]:
                yield os_window, tab, window


def own_window():
    own_id = os.environ.get("KITTY_WINDOW_ID")
    for _, _, window in kitty_windows():
        if own_id and str(window["id"]) == own_id:
            return window
    for os_window, tab, window in kitty_windows():
        if os_window.get("is_focused") and tab.get("is_active") and window.get("is_active"):
            return window
    raise SystemExit("claude-diff: cannot find the kitty window to split")


def pane_tag(root):
    return hashlib.sha1(root.encode()).hexdigest()[:10]


def pane_window(root):
    tag = pane_tag(root)
    return next((w for _, _, w in kitty_windows() if w.get("user_vars", {}).get("claude_diff") == tag), None)


def pane_open(root, refs, compare, options):
    pane_close(root)
    own = own_window()
    tag = pane_tag(root)
    kitty("goto-layout", "--match", f"window_id:{own['id']}", "splits")
    kitty(
        "launch",
        "--type=window",
        "--location=vsplit",
        "--keep-focus",
        "--match",
        f"id:{own['id']}",
        "--cwd",
        root,
        "--var",
        f"claude_diff={tag}",
        "--env",
        f"PATH={os.environ.get('PATH', '')}",
        "--title",
        f"diff {compare.base_label} → {compare.head_label}",
        os.path.abspath(sys.argv[0]),
        *options,
        *refs,
    )
    target = round(own["columns"] * PANE_FRACTION)
    for _ in range(3):
        pane = pane_window(root)
        if pane is None:
            return
        delta = pane["columns"] - target
        if abs(delta) < 2:
            return
        kitty("resize-window", "--match", f"id:{pane['id']}", "--axis", "horizontal", "--increment", str(-delta), check=False)


def pane_close(root):
    window = pane_window(root)
    if window:
        kitty("close-window", "--match", f"id:{window['id']}")
    return window is not None


def become_pane(root):
    own_id = os.environ.get("KITTY_WINDOW_ID")
    if not own_id or not os.environ.get("KITTY_LISTEN_ON"):
        return True
    existing = pane_window(root)
    if existing and str(existing["id"]) != own_id:
        kitty("close-window", "--match", f"id:{existing['id']}", check=False)
        return False
    kitty("set-user-vars", "--match", f"id:{own_id}", f"claude_diff={pane_tag(root)}", check=False)
    own = next((w for _, _, w in kitty_windows() if str(w["id"]) == own_id), None)
    if own:
        delta = round(own["columns"] * (1 - PANE_FRACTION / 0.5))
        if delta > 0:
            kitty("resize-window", "--match", f"id:{own_id}", "--axis", "horizontal", "--increment", str(-delta), check=False)
    return True


def main():
    parser = argparse.ArgumentParser(
        prog="claude-diff",
        description="Browse a git diff with a file tree and expandable context. Refreshes while files change.",
    )
    parser.add_argument(
        "refs",
        nargs="*",
        help="BASE (against the working tree), BASE HEAD or BASE...HEAD (what HEAD adds since the merge base), "
        "or BASE..HEAD (plain two-point diff). Default: merge base with the default branch, against the working tree.",
    )
    parser.add_argument("--pane", action="store_true", help="open in a kitty split to the right of this window")
    parser.add_argument("--close", action="store_true", help="close the kitty split for this repository")
    parser.add_argument("--toggle", action="store_true", help="open the kitty split, or close it if it is open")
    parser.add_argument("--context", type=int, default=3, choices=CONTEXT_STEPS, help="context lines around a change")
    parser.add_argument("--layout", choices=LAYOUTS, default="top", help="where the file tree goes; t cycles at run time")
    parser.add_argument(
        "--pr",
        nargs="?",
        const="current",
        metavar="NUMBER|URL",
        help="compare a GitHub pull request: its head against the merge base with its base branch. "
        "Without a value, the pull request of the current branch. Needs gh.",
    )
    parser.add_argument(
        "--local",
        action="store_true",
        help="with --pr: compare the local branch of the pull request, with uncommitted changes when it is "
        "checked out, against the base branch on origin",
    )
    parser.add_argument(
        "--worktree",
        metavar="NAME|PATH",
        help="use another worktree of this repository, by directory name, branch, or path",
    )
    parser.add_argument("--toggle-self", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.pr and args.refs:
        parser.error("give either revisions or --pr, not both")
    if args.local and not args.pr:
        parser.error("--local needs --pr")
    try:
        root = repo_root(os.getcwd())
        if args.worktree:
            root = find_worktree(root, args.worktree)
        if args.close:
            raise SystemExit(0 if pane_close(root) else 1)
        if args.toggle and pane_close(root):
            return
        if args.toggle_self and not become_pane(root):
            return
        compare = resolve_target(root, args.refs, args.pr, args.local)
    except GitError as error:
        raise SystemExit(f"claude-diff: {error}")
    if args.pane or args.toggle:
        if not os.environ.get("KITTY_LISTEN_ON"):
            raise SystemExit("claude-diff: --pane needs a kitty window with remote control enabled")
        options = ["--context", str(args.context), "--layout", args.layout]
        if args.pr:
            options += ["--pr", args.pr] + (["--local"] if args.local else [])
        pane_open(root, args.refs, compare, options)
        return
    DiffApp(root, args.refs, compare, args.context, layout=args.layout, pr=args.pr, pr_local=args.local).run()


if __name__ == "__main__":
    main()
