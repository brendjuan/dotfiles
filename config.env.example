# Work identity (default for all repos)
WORK_GIT_NAME="Your Work Name"
WORK_GIT_EMAIL="you@company.com"

# Personal identity (used for repos under ~/Personal/)
PERSONAL_GIT_NAME="Your Name"
PERSONAL_GIT_EMAIL="you@example.com"

# ROS workspace whose nix dev shell owns the DDS config (CYCLONEDDS_URI).
# install.sh writes ~/.config/dotfiles/env.sh, which resolves the current
# CYCLONEDDS_URI from this workspace's nix-direnv cache at source time.
ROS_WORKSPACE="/home/user/ros-workspace"
